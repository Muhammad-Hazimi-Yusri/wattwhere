---
import '../styles/global.css';
import BillFlowCards from '../components/charts/BillFlowCards.tsx';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

// Shared typography. Panels differ only in accent + copy.
const PANEL =
  'panel-reveal flex min-h-[100svh] flex-col justify-center max-w-2xl mx-auto px-6 py-16';
const EYEBROW = 'text-[11px] font-semibold uppercase tracking-[0.18em]';
const HERO =
  'mt-3 text-[4rem] leading-[1.05] md:text-[7rem] font-semibold tracking-tight tabular-nums';
const HERO_LABEL = 'mt-3 text-xl md:text-3xl font-medium text-white';
const BODY = 'mt-3 text-base md:text-lg text-white/80';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Where Britain's electricity comes from, where it goes, and what it costs."
    />
    <title>wattwhere</title>
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
  </head>
  <body>
    <main>
      <section class={PANEL}>
        <h1 class="text-5xl md:text-7xl font-semibold tracking-tight">wattwhere</h1>
        <p class="mt-4 text-lg md:text-xl text-[color:var(--muted)]">
          Where Britain's electricity comes from, where it goes, and what it
          costs — in a few numbers.
        </p>
        <p class="mt-8 text-sm uppercase tracking-[0.18em] text-white/40">
          Scroll ↓
        </p>
      </section>

      <section class={PANEL} style="--accent: #56B4E9">
        <p class={EYEBROW} style="color: var(--accent)">01 · The source</p>
        <h2 class={HERO} style="color: var(--accent)" aria-label="around three point six gigawatts">
          3.6&nbsp;GW
        </h2>
        <p class={HERO_LABEL}>Dogger Bank</p>
        <p class={BODY}>
          The world's largest offshore wind farm, around 130&nbsp;km off the
          Yorkshire coast.
        </p>
      </section>

      <section class={PANEL} style="--accent: #ef8a62">
        <p class={EYEBROW} style="color: var(--accent)">02 · Transmission</p>
        <h2 class={HERO} style="color: var(--accent)" aria-label="four hundred kilovolts">
          400&nbsp;kV
        </h2>
        <p class={HERO_LABEL}>The super-grid</p>
        <p class={BODY}>
          High-voltage lines carry that power hundreds of miles south to where
          it's used.
        </p>
      </section>

      <section class={PANEL} style="--accent: #58a6ff">
        <p class={EYEBROW} style="color: var(--accent)">03 · Your home</p>
        <h2 class={HERO} style="color: var(--accent)" aria-label="two hundred and thirty volts">
          230&nbsp;V
        </h2>
        <p class={HERO_LABEL}>At the socket</p>
        <p class={BODY}>
          Substations step it down, again and again, to the voltage your home
          runs on.
        </p>
      </section>

      <section class={PANEL} style="--accent: #fee08b">
        <p class={EYEBROW} style="color: var(--accent)">04 · Your bill</p>
        <h2 class={HERO} style="color: var(--accent)" aria-label="one pound">£1</h2>
        <p class={HERO_LABEL}>Where each pound goes</p>
        <p class={BODY}>
          Only part pays for the energy itself — the rest is network, policy,
          supplier costs, and VAT.
        </p>
        <BillFlowCards />
        <p class="mt-8">
          <a
            href={`${base}explore`}
            class="inline-block rounded-md border border-white/15 px-5 py-2.5 text-sm font-medium hover:bg-white/5"
          >
            Explore the live map →
          </a>
        </p>
      </section>
    </main>

    <footer class="mx-auto max-w-2xl px-6 py-10 text-[11px] leading-relaxed text-white/45">
      Map © OpenStreetMap contributors (ODbL), basemap © CARTO. BMRS data ©
      Elexon Limited. Carbon Intensity © National Grid ESO (CC-BY 4.0). Bill
      breakdown illustrative, after Ofgem's default tariff cap.
    </footer>
  </body>
</html>
